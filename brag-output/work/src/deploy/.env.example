# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Database password (URL-safe characters only: it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me
# One or more <sha256-hex>:<tenant>:<workspace> entries, comma-separated.
# Create one with: compliance-engine token generate --tenant <id> --workspace <id>
COMPLIANCE_TOKENS=
# Host port the API is published on (bound to 127.0.0.1).
COMPLIANCE_HOST_PORT=8080
